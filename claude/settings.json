{
  "model": "opus[1m]",
  "env": {
    "MCP_TIMEOUT": "60000"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/workflow-review-nudge.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/claude-work-sync.sh",
            "async": true
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/code_checks.py",
            "timeout": 600
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(gh pr create*)",
            "onFailure": "block",
            "command": "$HOME/.claude/hooks/pr-prose-gate.py"
          },
          {
            "type": "command",
            "if": "Bash(gh pr ready*)",
            "onFailure": "block",
            "command": "$HOME/.claude/hooks/pr-prose-gate.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/code_checks.py",
            "timeout": 120
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "$HOME/.claude/statusline.sh"
  },
  "extraKnownMarketplaces": {
    "recurve-plugins": {
      "source": {
        "source": "git",
        "url": "git@github.com:recurve-inc/claude-plugins.git"
      }
    }
  },
  "outputStyle": "colleague",
  "modelSettings": {
    "claude-opus-5-5": {}
  },
  "skipAutoPermissionPrompt": true
}
