{
  "model": "opus[1m]",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": []
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/workflow-review-nudge.sh"
          }
        ]
      }
    ]
  },
  "skipAutoPermissionPrompt": true,
  "extraKnownMarketplaces": {
    "recurve-plugins": {
      "source": {
        "source": "git",
        "url": "git@github.com:recurve-inc/claude-plugins.git"
      }
    }
  }
}
