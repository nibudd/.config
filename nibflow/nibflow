#!/usr/bin/env -S uv run --quiet --script
# /// script
# requires-python = ">=3.11"
# dependencies = ["pyyaml"]
# ///
import os
import subprocess
import sys
from pathlib import Path

from actions import LIST_WINDOWS_FORMAT, Window, decide
from layout import Layout
from lookup import branch_from_git_output, find_tasks, work_root

HERE = Path(__file__).resolve().parent
DEFAULT_LAYOUT = "large"


def git(*arguments: str) -> str | None:
    result = subprocess.run(["git", *arguments], capture_output=True, text=True)
    return result.stdout if result.returncode == 0 else None


def git_toplevel() -> Path | None:
    output = git("rev-parse", "--show-toplevel")
    return None if output is None else Path(output.strip())


def git_branch() -> str | None:
    output = git("branch", "--show-current")
    return None if output is None else branch_from_git_output(output)


def tmux(*arguments: str) -> str:
    return subprocess.run(["tmux", *arguments], capture_output=True, text=True, check=True).stdout


def tmux_windows(in_tmux: bool) -> list[Window]:
    if not in_tmux:
        return []
    output = tmux("list-windows", "-F", LIST_WINDOWS_FORMAT)
    return [Window.from_list_windows_line(line) for line in output.splitlines()]


def main(argv: list[str]) -> int:
    in_tmux = bool(os.environ.get("TMUX"))
    action = decide(
        in_tmux=in_tmux,
        toplevel=git_toplevel(),
        branch=git_branch(),
        key=argv[0] if argv else None,
        tasks=find_tasks(work_root()),
        windows=tmux_windows(in_tmux),
        layout=Layout.load(DEFAULT_LAYOUT),
        nibflow_dir=HERE,
    )
    for invocation in action.tmux_invocations:
        tmux(*invocation)
    if action.message:
        print(action.message, file=sys.stderr)
    return action.exit_code


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
